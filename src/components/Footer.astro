---
const anio = new Date().getFullYear();

const columnas = [
  {
    titulo: 'Tienda',
    enlaces: [
      { texto: 'Catálogo', href: '#catalogo' },
      { texto: 'Origen', href: '#origen' },
      { texto: 'Pedidos', href: '#pedidos' },
    ],
  },
  {
    titulo: 'Tostaduría',
    enlaces: [
      { texto: 'Av. del Tostado 1420', href: '#top' },
      { texto: 'Palermo, CABA', href: '#top' },
      { texto: 'Lun a Sáb · 8–20 h', href: '#top' },
    ],
  },
];

const sociales = [
  { texto: 'Instagram', href: 'https://www.instagram.com' },
  { texto: 'WhatsApp', href: 'tel:+541155550123' },
  { texto: 'Email', href: 'mailto:hola@altura.cafe' },
];
---

<footer class="pie">
  <div class="contenedor pie__grid">
    <div class="pie__marca">
      <span class="pie__nombre">Altura</span>
      <p class="pie__lema">
        Tostaduría de especialidad. Microlotes de fincas familiares, tostados en casa cada
        semana.
      </p>
    </div>

    {
      columnas.map((col) => (
        <nav class="pie__col" aria-label={col.titulo}>
          <h2 class="pie__titulo">{col.titulo}</h2>
          <ul>
            {col.enlaces.map((e) => (
              <li>
                <a href={e.href}>{e.texto}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }

    <nav class="pie__col" aria-label="Redes y contacto">
      <h2 class="pie__titulo">Seguinos</h2>
      <ul>
        {
          sociales.map((s) => (
            <li>
              <a href={s.href} rel="noopener">{s.texto}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div class="contenedor pie__base">
    <p>© {anio} Altura Tostaduría. Todos los derechos reservados.</p>
    <p class="pie__credito">Fotografías: Pexels</p>
  </div>
</footer>

<style>
  .pie {
    background: var(--espresso);
    color: rgba(246, 239, 228, 0.72);
    padding-top: clamp(3rem, 7vw, 5rem);
    padding-bottom: var(--e-4);
  }

  .pie__grid {
    display: grid;
    grid-template-columns: 1.6fr repeat(3, 1fr);
    gap: clamp(1.75rem, 4vw, 3rem);
    padding-bottom: var(--e-6);
  }

  .pie__nombre {
    font-family: var(--fuente-titulo);
    font-size: var(--t-2);
    font-weight: 600;
    color: var(--blanco);
  }

  .pie__lema {
    margin-top: var(--e-2);
    max-width: 34ch;
    font-size: var(--t--1);
    line-height: 1.6;
  }

  .pie__titulo {
    margin: 0 0 var(--e-3);
    font-family: var(--fuente-texto);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--caramelo);
  }

  .pie__col ul {
    display: grid;
    gap: 0.6rem;
  }

  .pie__col a {
    font-size: var(--t--1);
    transition: color var(--transicion);
  }

  .pie__col a:hover {
    color: var(--blanco);
  }

  .pie__base {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--e-2);
    padding-top: var(--e-4);
    border-top: 1px solid var(--borde-claro);
    font-size: var(--t--1);
  }

  .pie__base p {
    margin: 0;
  }

  .pie__credito {
    color: rgba(246, 239, 228, 0.5);
  }

  @media (max-width: 860px) {
    .pie__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 520px) {
    .pie__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

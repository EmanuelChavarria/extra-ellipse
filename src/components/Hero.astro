---
import { Image } from 'astro:assets';
import hero from '../assets/hero.jpg';

const datos = [
  { valor: '12', texto: 'fincas aliadas' },
  { valor: '48 h', texto: 'del tueste a tu casa' },
  { valor: '100%', texto: 'trazabilidad de origen' },
];
---

<section class="hero" id="top">
  <div class="hero__fondo">
    <Image
      src={hero}
      alt="Barista preparando café detrás de la barra de la tostaduría"
      widths={[768, 1280, 1920]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="hero__img"
    />
    <div class="hero__velo" aria-hidden="true"></div>
  </div>

  <div class="hero__contenido contenedor">
    <p class="eyebrow hero__eyebrow">Tostaduría de especialidad</p>
    <h1 class="hero__titulo">Café de altura,<br />tostado en casa.</h1>
    <p class="hero__texto">
      Seleccionamos microlotes de fincas familiares y los tostamos en pequeños lotes cada
      semana. Trazabilidad completa, del árbol a tu taza.
    </p>

    <div class="hero__acciones">
      <a class="btn btn--primario" href="#catalogo">Ver el catálogo</a>
      <a class="btn btn--fantasma" href="#pedidos">Pedidos por encargo</a>
    </div>
  </div>

  <dl class="hero__datos contenedor">
    {
      datos.map((d) => (
        <div class="hero__dato">
          <dt>{d.valor}</dt>
          <dd>{d.texto}</dd>
        </div>
      ))
    }
  </dl>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: clamp(34rem, 88vh, 50rem);
    padding-bottom: clamp(1.5rem, 4vw, 2.5rem);
    color: var(--crema);
    overflow: hidden;
  }

  .hero__fondo {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 42%;
  }

  .hero__velo {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(20, 13, 10, 0.72) 0%, rgba(20, 13, 10, 0.28) 34%, rgba(20, 13, 10, 0.55) 68%, rgba(20, 13, 10, 0.92) 100%),
      radial-gradient(120% 80% at 15% 30%, rgba(20, 13, 10, 0.15), transparent 60%);
  }

  .hero__contenido {
    display: grid;
    gap: var(--e-4);
    max-width: 46rem;
    margin-block: auto;
    padding-top: clamp(3rem, 8vw, 6rem);
  }

  .hero__eyebrow {
    color: var(--caramelo);
  }

  .hero__titulo {
    font-size: var(--t-5);
    font-weight: 500;
    letter-spacing: -0.025em;
    color: var(--blanco);
  }

  .hero__texto {
    max-width: 42ch;
    font-size: var(--t-1);
    color: rgba(246, 239, 228, 0.82);
  }

  .hero__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-3);
    margin-top: var(--e-2);
  }

  .hero__datos {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--e-4);
    margin-top: clamp(2.5rem, 6vw, 4rem);
    padding-top: var(--e-4);
    border-top: 1px solid var(--borde-claro);
  }

  .hero__dato dt {
    font-family: var(--fuente-titulo);
    font-size: var(--t-2);
    font-weight: 600;
    color: var(--blanco);
  }

  .hero__dato dd {
    margin: 0.15rem 0 0;
    font-size: var(--t--1);
    letter-spacing: 0.02em;
    color: rgba(246, 239, 228, 0.7);
  }

  @media (max-width: 720px) {
    .hero__datos {
      grid-template-columns: 1fr;
      gap: var(--e-3);
    }

    .hero__dato {
      display: flex;
      align-items: baseline;
      gap: 0.6rem;
    }

    .hero__dato dd {
      margin-top: 0;
    }
  }
</style>
